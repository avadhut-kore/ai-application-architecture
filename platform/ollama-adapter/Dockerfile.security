FROM golang@sha256:5de7c99eb78ca5e515a4c340235d0955ec5964a5071c492c15503d7c267da473 AS build
WORKDIR /src
ADD --checksum=sha256:296dc8dd88a617335d9132412179f11926d266941d53a4727917fd18ac675053 https://codeload.github.com/ollama/ollama/tar.gz/refs/tags/v0.40.16 /tmp/ollama.tar.gz
RUN tar -xzf /tmp/ollama.tar.gz --strip-components=1 && rm /tmp/ollama.tar.gz
ENV CGO_ENABLED=1 GOMAXPROCS=2
RUN go get golang.org/x/net@v0.62.0
RUN go build -p 2 -trimpath -buildmode=pie -ldflags="-w -s -X github.com/ollama/ollama/version.Version=0.40.16-security.1" -o /out/ollama .
FROM ollama/ollama@sha256:910d0d8107b538fb0894e63163eb195de0cc7aefcbc666dc62d3b18f71124592
RUN sed -i 's|http://|https://|g' /etc/apt/sources.list.d/ubuntu.sources \
    && apt-get -o Acquire::Retries=0 update \
    && apt-get -o Acquire::Retries=0 install --only-upgrade -y apt=2.8.4ubuntu0.1 libapt-pkg6.0t64=2.8.4ubuntu0.1 \
    && rm -rf /var/lib/apt/lists/*
COPY --from=build /out/ollama /usr/bin/ollama
LABEL org.opencontainers.image.source="https://github.com/ollama/ollama" \
      org.opencontainers.image.revision="d63b702609c4300a2ca07be2bdb0adb9834725e5"
