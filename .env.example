# Copy to .env and create this directory before docker compose up -d.
# Windows example; Linux users can use an absolute directory on their data disk.
OLLAMA_MODEL_DIR=D:/ai-models/ollama
OLLAMA_ENDPOINT=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
# Optional metadata-only trace export for Python CLI processes.
AI_TRACE_FILE=.quality/traces/local.jsonl
